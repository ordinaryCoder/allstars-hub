generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApprovalStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model Academy {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz

  users_roles UserAcademyRole[]
  locations   Location[]
  sports      Sport[]
  batches     Batch[]
  players     Player[]
  sessions    Session[]
  attendance  Attendance[]

  @@map("academies")
}

model User {
  id            String         @id @db.Uuid
  email         String         @unique
  first_name    String
  last_name     String
  mobile_number String?
  status        ApprovalStatus @default(PENDING)
  created_at    DateTime       @default(now()) @db.Timestamptz

  academy_roles     UserAcademyRole[]
  sessions_created  Session[]         @relation("CreatedBy")
  sessions_coaching Session[]         @relation("SessionCoach")
  attendance_marked Attendance[]      @relation("MarkedBy")
  parent_of         ParentPlayer[]
  coachLocations    CoachLocation[]
  players           Player[]          @relation("UserPlayers")

  @@map("users")
}

model UserAcademyRole {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String @db.Uuid
  academy_id  String @db.Uuid
  permissions Json // e.g. ["admin", "coach", "parent", "player"]

  user    User    @relation(fields: [user_id], references: [id])
  academy Academy @relation(fields: [academy_id], references: [id])

  @@unique([user_id, academy_id]) // prevents duplicate role rows per user per academy
  @@index([user_id])              // token hook + RLS lookup
  @@index([academy_id])           // admin user listing
  @@map("user_academy_roles")
}

model Location {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academy_id String  @db.Uuid
  name       String
  address    String?

  academy        Academy         @relation(fields: [academy_id], references: [id])
  sessions       Session[]
  batches        Batch[]
  players        Player[]
  coachLocations CoachLocation[]

  @@map("locations")
}

model Sport {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academy_id String @db.Uuid
  name       String // e.g., Cricket, Football

  academy Academy @relation(fields: [academy_id], references: [id])
  batches Batch[]

  @@map("sports")
}

model Batch {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academy_id  String @db.Uuid
  location_id String @db.Uuid
  sport_id    String @db.Uuid
  name        String // e.g., Morning U-15
  age_min     Int? // null = open/any age
  age_max     Int? // null = open/any age

  academy  Academy  @relation(fields: [academy_id], references: [id])
  location Location @relation(fields: [location_id], references: [id])
  sport    Sport    @relation(fields: [sport_id], references: [id])

  players  PlayerBatch[]
  sessions SessionBatch[]

  @@map("batches")
}

model Player {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academy_id  String   @db.Uuid
  location_id String   @db.Uuid // Player's primary or registered branch
  user_id     String?  @db.Uuid // Nullable for self-login
  first_name  String
  last_name   String
  dob         DateTime @db.Date
  is_active   Boolean  @default(true)

  user       User?          @relation("UserPlayers", fields: [user_id], references: [id])
  academy    Academy        @relation(fields: [academy_id], references: [id])
  location   Location       @relation(fields: [location_id], references: [id])
  batches    PlayerBatch[]
  attendance Attendance[]
  parents    ParentPlayer[]

  @@index([location_id, is_active]) // coach player list + RLS location filter
  @@index([academy_id])             // RLS tenant isolation check
  @@index([user_id])                // self-view RLS condition
  @@map("players")
}

model Session {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academy_id  String   @db.Uuid
  location_id String   @db.Uuid
  created_by  String   @db.Uuid
  start_time  DateTime @db.Timestamptz
  end_time    DateTime @db.Timestamptz
  coach_id    String?  @db.Uuid // Ad-hoc or specific assignment

  academy  Academy  @relation(fields: [academy_id], references: [id])
  location Location @relation(fields: [location_id], references: [id])
  creator  User     @relation("CreatedBy", fields: [created_by], references: [id])
  coach    User?    @relation("SessionCoach", fields: [coach_id], references: [id])

  goals      Goal[]
  batches    SessionBatch[]
  attendance Attendance[]

  @@index([academy_id, start_time(sort: Desc)]) // dashboard + admin session list (most common filter)
  @@index([coach_id])                           // coach dashboard filter + RLS visibility
  @@index([location_id])                        // RLS location-based access
  @@index([created_by])                         // spontaneous session queries
  @@map("sessions")
}

model SessionBatch {
  session_id String @db.Uuid
  batch_id   String @db.Uuid

  session Session @relation(fields: [session_id], references: [id])
  batch   Batch   @relation(fields: [batch_id], references: [id])

  @@id([session_id, batch_id])
  @@map("session_batches")
}

model PlayerBatch {
  player_id String @db.Uuid
  batch_id  String @db.Uuid

  player Player @relation(fields: [player_id], references: [id])
  batch  Batch  @relation(fields: [batch_id], references: [id])

  @@id([player_id, batch_id])
  @@map("player_batches")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academy_id String           @db.Uuid
  session_id String           @db.Uuid
  player_id  String           @db.Uuid
  marked_by  String           @db.Uuid
  status     AttendanceStatus @default(ABSENT)
  marked_at  DateTime         @default(now()) @db.Timestamptz

  academy Academy @relation(fields: [academy_id], references: [id])
  session Session @relation(fields: [session_id], references: [id])
  player  Player  @relation(fields: [player_id], references: [id])
  marker  User    @relation("MarkedBy", fields: [marked_by], references: [id])

  @@unique([session_id, player_id])    // prevents duplicate attendance on retry/double-submit
  @@index([session_id])                // every attendance lookup by session
  @@index([player_id])                 // player attendance history
  @@index([academy_id])                // RLS tenant isolation
  @@index([session_id, status])        // report page aggregation (present/late counts)
  @@map("attendance")
}

model ParentPlayer {
  parent_user_id String @db.Uuid
  player_id      String @db.Uuid

  parent User   @relation(fields: [parent_user_id], references: [id])
  player Player @relation(fields: [player_id], references: [id])

  @@id([parent_user_id, player_id])
  @@index([parent_user_id]) // parent self-view RLS + parent_player lookups
  @@index([player_id])      // player → parent resolution
  @@map("parent_player")
}

model Goal {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id   String  @db.Uuid
  title        String
  is_completed Boolean @default(false)

  session Session @relation(fields: [session_id], references: [id])

  @@index([session_id]) // goals lookup per session + RLS check
  @@map("goals")
}

model CoachLocation {
  user_id     String @db.Uuid
  location_id String @db.Uuid

  user     User     @relation(fields: [user_id], references: [id])
  location Location @relation(fields: [location_id], references: [id])

  @@id([user_id, location_id])
  @@map("coach_locations")
}
